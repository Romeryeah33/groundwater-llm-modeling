{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://groundwater-llm-modeling/ir_schema_v1.0.json",
  "title": "Groundwater Modeling Intermediate Representation (JSON IR)",
  "description": "物理约束嵌入LLM的地下水智能建模 — 中间态参数协议 v1.0",
  "version": "1.0.0",
  "type": "object",

  "x-gw-status-legend": {
    "not_implemented": "此字段在协议里保留，但**当前程序没有任何代码读取它** —— 写进 IR 也不会影响建模结果。标注依据是 2026-10-12 对 app/ 全目录的实际 grep。要改成已实现，得先真的接线，再改标注。",
    "implemented": "字段被真实消费（默认：未标注即视为已实现）。带此标注的字段另附 consume_by 指出消费方。",
    "why-annotate": "标错比不标更坏：误把活代码标成 not_implemented，会误导下一个接手的人把它删掉。所以每一条标注都必须有 grep 证据，且 tests/test_ir_schema.py 会锁住这份标注表与消费方。"
  },
  "required": ["ir_version", "project", "domain", "grid", "aquifer"],
  "properties": {
    "ir_version": {
      "type": "string",
      "description": "IR协议版本号",
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "required": ["name", "model_type"],
      "properties": {
        "name": {"type": "string", "description": "项目/模型名称"},
        "description": {"type": "string", "description": "项目描述"},
        "model_type": {
          "type": "string",
          "enum": ["groundwater_flow", "solute_transport", "reactive_transport"],
          "description": "模拟类型"
        }
      }
    },
    "domain": {
      "type": "object",
      "required": ["x_range", "y_range", "units"],
      "properties": {
        "x_range": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "number"},
          "description": "模型X方向范围 [xmin, xmax]"
        },
        "y_range": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "number"},
          "description": "模型Y方向范围 [ymin, ymax]"
        },
        "units": {
          "type": "string", "default": "meters",
          "description": "长度单位"
        },
        "rotation_angle": {
          "type": "number", "default": 0.0,
          "description": "网格旋转角度（度）",
          "x-gw-status": "not_implemented"
        },
        "origin_xy": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number"},
          "description": "网格左下角在 SHP/真实坐标系中的 [x0, y0]。上传 SHP 时由程序按边界外框自动写入，源区选格与底图对齐都以此为准；缺省表示使用局部坐标系原点 (0, 0)。"
        },
        "crs": {
          "type": "string", "description": "坐标参考系 (EPSG code)",
          "x-gw-status": "not_implemented"
        }
      }
    },
    "grid": {
      "type": "object",
      "required": ["nrow", "ncol", "nlay"],
      "properties": {
        "nrow": {"type": "integer", "minimum": 1, "description": "行数"},
        "ncol": {"type": "integer", "minimum": 1, "description": "列数"},
        "nlay": {"type": "integer", "minimum": 1, "description": "层数"},
        "delr": {
          "oneOf": [
            {"type": "number", "minimum": 0, "description": "均匀行宽 (m)"},
            {"type": "array", "items": {"type": "number"}, "description": "各行宽度数组"}
          ]
        },
        "delc": {
          "oneOf": [
            {"type": "number", "minimum": 0, "description": "均匀列宽 (m)"},
            {"type": "array", "items": {"type": "number"}, "description": "各列宽度数组"}
          ]
        },
        "top": {
          "oneOf": [
            {"type": "number", "description": "均匀顶层高程 (m)"},
            {"type": "array", "description": "二维顶层高程数组"}
          ]
        },
        "bottom": {
          "oneOf": [
            {"type": "number", "description": "均匀底层高程 (m)"},
            {"type": "array", "description": "三维底层高程数组"}
          ]
        },
        "refinement_zones": {
          "type": "array",
          "x-gw-status": "implemented",
          "x-gw-consume_by": "app/modeling/grid_generator.py:32,73,119",
          "items": {
            "type": "object",
            "properties": {
              "type": {"enum": ["point", "polygon"]},
              "coordinates": {},
              "refinement_factor": {"type": "number"}
            }
          }
        }
      }
    },
    "aquifer": {
      "type": "object",
      "required": ["type", "parameters"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["confined", "unconfined", "convertible"],
          "description": "含水层类型"
        },
        "parameters": {
          "type": "object",
          "required": ["hk"],
          "properties": {
            "hk": {
              "$ref": "#/definitions/param_with_constraint",
              "description": "水平渗透系数"
            },
            "vka": {
              "$ref": "#/definitions/param_with_constraint",
              "description": "垂向渗透系数"
            },
            "hani": {
              "$ref": "#/definitions/param_with_constraint",
              "description": "水平各向异性比"
            },
            "sy": {
              "$ref": "#/definitions/param_with_constraint",
              "description": "给水度"
            },
            "ss": {
              "$ref": "#/definitions/param_with_constraint",
              "description": "储水系数"
            },
            "porosity": {
              "$ref": "#/definitions/param_with_constraint",
              "description": "孔隙度"
            }
          }
        },
        "zones": {
          "type": "array",
          "description": "参数分区（非均质）",
          "x-gw-status": "not_implemented",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "geometry": {},
              "parameters": {"type": "object"}
            }
          }
        }
      }
    },
    "boundary_conditions": {
      "type": "array",
      "description": "边界条件列表",
      "items": {
        "type": "object",
        "required": ["type", "name"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["chd", "ghb", "wel", "riv", "drn", "rch", "evt"],
            "description": "边界条件类型"
          },
          "name": {"type": "string", "description": "边界名称"},
          "geometry": {
            "type": "object",
            "properties": {
              "shape": {"enum": ["point", "line", "polygon"]},
              "coordinates": {},
              "grid_indices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "layer": {"type": "integer"},
                    "row": {"type": "integer"},
                    "col": {"type": "integer"}
                  }
                }
              }
            }
          },
          "parameters": {"type": "object", "description": "边界参数（头值、传导系数等）"},
          "stress_periods": {
            "type": "array",
            "description": "该边界随应力期变化的取值。**这是活字段**（初稿的标注清单曾把它误列为未实现，实测被 model_mapper 读取）。",
            "x-gw-status": "implemented",
            "x-gw-consume_by": "app/modeling/model_mapper.py:267",
            "items": {
              "type": "object",
              "properties": {
                "period": {"type": "integer"},
                "value": {"type": "number"}
              }
            }
          }
        }
      }
    },
    "stress_periods": {
      "type": "object",
      "required": ["nper", "steady_state"],
      "properties": {
        "nper": {"type": "integer", "minimum": 1, "description": "应力期数量"},
        "steady_state": {"type": "boolean", "description": "是否稳态"},
        "total_time": {
          "type": "number",
          "minimum": 0,
          "description": "【总】模拟时长 (d)。与 nper 配合使用：程序按 total_time / nper 等分每个应力期的长度。用户说\"模拟时长15000天，分为10个应力期\"时应填这里，而不是把 15000 填进 perlen。"
        },
        "perlen": {
          "type": "number",
          "minimum": 0,
          "description": "【单个】应力期的长度 (d)，不是总时长。10 期 × perlen 15000 = 总时长 150000 d，极易被误读；当用户说的是总时长时请改用 total_time。"
        },
        "nstp": {"type": "integer", "minimum": 1, "description": "每个应力期的时间步数"},
        "tsmult": {"type": "number", "default": 1.0, "description": "步长乘子"},
        "period_data": {
          "type": "array",
          "description": "逐期显式给出时间离散。优先级最高，存在时 total_time / perlen 均不生效。",
          "items": {
            "type": "object",
            "properties": {
              "perlen": {"type": "number", "description": "该期长度 (d)"},
              "nstp": {"type": "integer", "description": "该期时间步数"},
              "tsmult": {"type": "number", "default": 1.0, "description": "步长乘子"}
            }
          }
        }
      }
    },
    "initial_conditions": {
      "type": "object",
      "description": "初始条件。当前只消费 `head`（稳态时用作初始水头猜测）。",
      "x-gw-status": "implemented",
      "x-gw-consume_by": "app/modeling/model_builder.py:818, app/llm_agent/intent_parser.py:1138",
      "properties": {
        "head": {
          "oneOf": [
            {"type": "number", "description": "均匀初始水头 (m)"},
            {"type": "array", "description": "逐格初始水头数组"}
          ]
        }
      }
    },
    "source_sinks": {
      "type": "object",
      "description": "源汇项（抽水井 / 补给等）的另一种写法。解析器把它列入合法顶层键（`IntentParser.VALID_TOP_KEYS`），但没有建模代码读它 —— 井与补给实际走 `boundary_conditions` 里的 `wel` / `rch`。",
      "x-gw-status": "not_implemented"
    },
    "observation_points": {
      "type": "array",
      "description": "观测点。解析器把它列入合法顶层键，但没有建模代码读它（`output.observation_points` 同样无人读）。",
      "x-gw-status": "not_implemented"
    },
    "transport": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "species": {
          "type": "array",
          "items": {"type": "string"},
          "description": "溶质组分列表",
          "x-gw-status": "implemented",
          "x-gw-consume_by": "app/modeling/model_mapper.py:446"
        },
        "dispersion": {
          "type": "object",
          "properties": {
            "al": {"$ref": "#/definitions/param_with_constraint"},
            "trpt": {"$ref": "#/definitions/param_with_constraint"},
            "trpv": {"$ref": "#/definitions/param_with_constraint"},
            "diffc": {"$ref": "#/definitions/param_with_constraint"}
          }
        },
        "porosity": {
          "description": "有效孔隙度。可以写成标量，也可以写成逐层数组（如 {\"value\": [0.3, 0.2]}，第 1 层在前，长度须等于 grid.nlay）。逐层时程序写 LAYERED，标量写 CONSTANT。"
        },
        "initial_concentration": {
          "description": "初始浓度 (mg/L)。写进 GWT 的 IC 包。不写按 0 处理。（此字段原先漏在 schema 里，2026-10-12 补上 —— 程序一直在读它。）",
          "x-gw-status": "implemented",
          "x-gw-consume_by": "app/modeling/model_mapper.py:626, app/modeling/model_builder.py:981"
        },
        "advection": {
          "type": "object",
          "properties": {
            "scheme": {
              "type": "string",
              "enum": ["upstream", "central", "tvd"],
              "default": "upstream",
              "x-gw-status": "implemented",
              "x-gw-consume_by": "app/modeling/model_mapper.py:447,617"
            }
          }
        },
        "reaction": {
          "type": "object",
          "properties": {
            "sorption": {
              "type": "string",
              "enum": ["none", "linear", "freundlich", "langmuir"],
              "default": "none"
            },
            "kd": {"$ref": "#/definitions/param_with_constraint",
                   "description": "分配系数，单位 L/kg（惯用写法 mL/g，两者数值相同）。程序写入 MF6 时换算成 m3/kg。逐层写数组。"},
            "bulk_density": {"$ref": "#/definitions/param_with_constraint",
                             "description": "含水层介质干容重，单位 kg/L（与 g/cm3 数值相同）。线性/非线性吸附必须配它；IR 中不给时程序按 1.7 kg/L 兜底，并在界面上标明来源。程序写入 MF6 时换算成 kg/m3。"},
            "sp2": {"$ref": "#/definitions/param_with_constraint",
                    "description": "Freundlich 指数（sorption=freundlich）或 Langmuir 最大吸附量（sorption=langmuir）。IR 中不给时程序按 1.0 兜底并给出提示。"},
            "decay": {
              "type": "object",
              "properties": {
                "type": {"enum": ["none", "first_order", "multi_species"]},
                "first_order_rate": {"$ref": "#/definitions/param_with_constraint",
                                     "description": "一级降解/衰减速率 λ，单位 1/d。与 half_life 二选一；两者都给时 first_order_rate 优先。"},
                "half_life": {"$ref": "#/definitions/param_with_constraint",
                              "description": "半衰期 t½，单位 d。程序按 λ = ln2/t½ 换算，**不要**在 IR 里自行换算成 λ（界面上会显示换算结果）。"}
              }
            },
            "rt3d_package": {
              "type": "string",
              "description": "RT3D 反应包名（历史遗留字段）",
              "x-gw-status": "not_implemented"
            }
          }
        }
      }
    },
    "solver": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": ["pcg", "nwt", "sip", "sor"],
          "default": "pcg",
          "description": "求解器类型"
        },
        "parameters": {
          "type": "object",
          "properties": {
            "hclose": {"type": "number", "default": 1e-5},
            "rclose": {"type": "number", "default": 1e-3},
            "max_iter": {"type": "integer", "default": 100},
            "relax": {
              "type": "number", "default": 1.0,
              "description": "松弛因子",
              "x-gw-status": "implemented",
              "x-gw-consume_by": "app/modeling/model_mapper.py:676"
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "description": "输出控制。**整段当前无人读取** —— 输出哪些量是程序按模拟类型自己决定的，写了也不生效。",
      "x-gw-status": "not_implemented",
      "properties": {
        "head": {"type": "boolean", "default": true},
        "drawdown": {"type": "boolean", "default": true},
        "budget": {"type": "boolean", "default": true},
        "concentration": {"type": "boolean", "default": false},
        "observation_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "layer": {"type": "integer"},
              "row": {"type": "integer"},
              "col": {"type": "integer"},
              "x": {"type": "number"},
              "y": {"type": "number"}
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "溯源与校验记录。**整段当前无人读取**（写进去不会影响建模，也不会出现在界面上）。",
      "x-gw-status": "not_implemented",
      "properties": {
        "created_by": {"type": "string"},
        "validation_status": {
          "type": "string",
          "enum": ["pending", "in_progress", "passed", "failed"]
        },
        "validation_log": {"type": "array"},
        "source_files": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "definitions": {
    "param_with_constraint": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": {
          "description": "参数值（标量、数组或null）"
        },
        "unit": {
          "type": "string",
          "description": "参数单位（SI标准单位）"
        },
        "valid_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number"},
          "description": "物理取值范围 [min, max]"
        },
        "source": {
          "type": "string",
          "enum": ["user_input", "auto_suggestion", "default", "file_import"],
          "description": "参数来源"
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low", "none"],
          "description": "参数置信度"
        }
      }
    }
  }
}
