# .env 配置文件 (示例)
# 复制此文件为 .env 并填入你的API密钥
# 注意：.env 文件不应提交到Git仓库

# LLM Provider: deepseek | openai | anthropic
LLM_PROVIDER=deepseek

# LLM Model (LiteLLM格式: provider/model_name)
LLM_MODEL=deepseek/deepseek-chat

# API Key (从对应平台获取)
LLM_API_KEY=your_api_key_here

# API Base URL (可选，用于代理或私有部署)
# LLM_API_BASE=https://api.deepseek.com/v1

# LLM参数
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# 服务端口
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
GRADIO_PORT=7860
