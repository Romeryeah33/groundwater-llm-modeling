# ============================================================
# 地下水智能建模系统 — 环境变量配置
# 复制此文件为 .env 并填入你的 API Key
#
#   cp .env.example .env
# ============================================================

# --- LLM 配置（必填） ---
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.deepseek.com/v1

# --- Gradio 配置（可选） ---
GRADIO_PORT=7860
GRADIO_SERVER_NAME=127.0.0.1

# --- 统一入口 `python -m app.main`（网页 + 接口一起起）---
# 只起接口不起网页：GW_WITH_UI=0
# 换成别的端口：GW_WEB_PORT / GW_API_PORT
GW_WITH_UI=1
GW_API_HOST=127.0.0.1
GW_API_PORT=8000

# --- REST 接口的可选口令闸（默认**不开**）---
# 按"每人自持密钥"的设计，接口本身不需要账号。若部署方想加一道门，
# 取消下面这行的注释并改成自己的口令，客户端需带请求头 X-API-Token。
# API_TOKEN=

# --- 会话编号的签名密钥（可选，但换部署机器时**务必固定**）---
# 用于把会话编号存进浏览器 localStorage。不设则用内置常量；
# 若改成随机值，服务器一重启用户就会看到"对话莫名没了"。
# GW_SESSION_SECRET=gw-llm-modeling-session-v1

# --- 界面上的调试类面板（默认**隐藏**）---
# 设 1 才显示「流水线追踪」面板与「图件修改」页签。
# 这两个挂在全局单例上，多人同时用会看到彼此的内容，故默认关闭。
# 一般用仓库里的「启动程序-调试模式.bat」，不必手改这里。
# GW_SHOW_DEBUG_PANELS=0

# --- 其他 LLM 提供商示例 ---
# OpenAI:
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o
#   LLM_API_KEY=sk-...
#   LLM_API_BASE=https://api.openai.com/v1
#
# 通义千问:
#   LLM_PROVIDER=openai
#   LLM_MODEL=qwen-plus
#   LLM_API_KEY=sk-...
#   LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
